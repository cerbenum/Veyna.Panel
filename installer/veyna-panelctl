#!/usr/bin/env bash
# =============================================================================
# veyna-panelctl — Cerbenum Panel Management CLI
# =============================================================================
set -euo pipefail
# shellcheck disable=SC2120,SC2119  # require_root called without passing args

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
readonly CTL_VERSION="2.0.0"
readonly PRODUCT_NAME="Cerbenum Panel"
readonly PANEL_USER="veyna-panel"
readonly INSTALL_DIR="/opt/veyna-panel"
readonly CONFIG_DIR="/etc/veyna-panel"
readonly CONFIG_FILE="${CONFIG_DIR}/config.env"
readonly DATA_DIR="/opt/veyna-panel/data"
readonly LOG_DIR="/var/log/veyna-panel"
readonly BACKUP_DIR_DEFAULT="/var/backups/veyna-panel"
readonly SERVICE_NAME="veyna-panel"
readonly SYSTEMD_UNIT="/etc/systemd/system/${SERVICE_NAME}.service"
readonly BINARY="${INSTALL_DIR}/bin/veyna-panel"

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

info()    { echo -e "${GREEN}[OK]${NC} $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }
fatal()   { error "$*"; exit 1; }
header()  { echo -e "\n${BOLD}${BLUE}--- $* ---${NC}\n"; }

# ---------------------------------------------------------------------------
# Config loader
# ---------------------------------------------------------------------------
load_config() {
    if [[ -f "${CONFIG_FILE}" ]]; then
        # shellcheck source=/dev/null
        source "${CONFIG_FILE}"
    fi
    BACKUP_DIR="${PANEL_BACKUP_DIR:-${BACKUP_DIR_DEFAULT}}"
}

# ---------------------------------------------------------------------------
# Check root
# ---------------------------------------------------------------------------
# shellcheck disable=SC2120  # called without passing args
require_root() {
    if [[ $EUID -ne 0 ]]; then
        fatal "This command requires root. Use: sudo veyna-panelctl $*"
    fi
}

# ---------------------------------------------------------------------------
# Certificate detection
# ---------------------------------------------------------------------------
detect_cert_type() {
    local domain="${PANEL_BASE_URL:-}"
    local tls_cert="${PANEL_TLS_CERT_PATH:-${CONFIG_DIR}/tls/fullchain.pem}"

    # Check if nginx config has ssl_certificate directive pointing to LE
    local nginx_conf="/etc/nginx/sites-available/${SERVICE_NAME}"
    if [[ -f "${nginx_conf}" ]]; then
        if grep -q "letsencrypt" "${nginx_conf}" 2>/dev/null; then
            local le_domain
            le_domain=$(grep -oP 'ssl_certificate\s+/etc/letsencrypt/live/\K[^/]+' "${nginx_conf}" 2>/dev/null || true)
            if [[ -n "${le_domain}" ]]; then
                # Check if it's an IP (LE-IP) or domain (LE)
                if [[ "${le_domain}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                    echo "lets-encrypt-ip"
                    return
                fi
                echo "lets-encrypt"
                return
            fi
        fi
    fi

    # Check for self-signed cert
    if [[ -f "${CONFIG_DIR}/tls/fullchain.pem" ]]; then
        echo "self-signed"
        return
    fi

    echo "unknown"
}

get_cert_expiry() {
    local cert_file="$1"
    if [[ -f "${cert_file}" ]]; then
        openssl x509 -enddate -noout -in "${cert_file}" 2>/dev/null | cut -d= -f2 || echo "unknown"
    else
        echo "N/A"
    fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_status() {
    header "${PRODUCT_NAME} Status"

    load_config

    if [[ ! -f "${SYSTEMD_UNIT}" ]]; then
        warn "Service not installed."
        return 1
    fi

    # Service status
    if systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
        info "Service: running"
    else
        error "Service: stopped"
    fi

    # Binary
    if [[ -x "${BINARY}" ]]; then
        local version
        version=$("${BINARY}" --version 2>/dev/null || echo "unknown")
        info "Binary: ${version}"
    else
        error "Binary: not found"
    fi

    # Config
    info "Config: ${CONFIG_FILE}"

    # Port
    local port="${PANEL_PORT:-8080}"
    info "Port: ${port}"

    # URL
    local scheme="https"
    local cert_type
    cert_type=$(detect_cert_type)
    if [[ "${cert_type}" == "none" ]]; then
        scheme="http"
    fi

    local host
    if [[ -n "${PANEL_BASE_URL:-}" ]]; then
        host=$(echo "${PANEL_BASE_URL}" | sed 's|https\?://||' | cut -d/ -f1)
    else
        host="localhost"
    fi
    info "URL: ${scheme}://${host}:${port}"

    # Certificate
    local cert_info="N/A"
    local cert_expiry="N/A"
    local nginx_conf="/etc/nginx/sites-available/${SERVICE_NAME}"
    if [[ -f "${nginx_conf}" ]]; then
        local cert_path
        cert_path=$(grep -oP 'ssl_certificate\s+\K[^\s;]+' "${nginx_conf}" 2>/dev/null || true)
        if [[ -n "${cert_path}" && -f "${cert_path}" ]]; then
            cert_expiry=$(get_cert_expiry "${cert_path}")
        fi
    fi
    info "Cert type: ${cert_type}"
    info "Cert expires: ${cert_expiry}"

    # Uptime
    local uptime
    uptime=$(systemctl show "${SERVICE_NAME}" --property=ActiveEnterTimestamp --value 2>/dev/null || echo "unknown")
    info "Running since: ${uptime}"
}

cmd_url() {
    load_config
    local port="${PANEL_PORT:-8080}"
    local admin_path="${PANEL_ADMIN_URL_PATH:-}"

    local scheme="https"
    local cert_type
    cert_type=$(detect_cert_type)
    if [[ "${cert_type}" == "none" ]]; then
        scheme="http"
    fi

    local host
    if [[ -n "${PANEL_BASE_URL:-}" ]]; then
        host=$(echo "${PANEL_BASE_URL}" | sed 's|https\?://||' | cut -d/ -f1)
    else
        host=$(curl -sf --max-time 5 https://api.ipify.org 2>/dev/null || echo "localhost")
    fi

    echo -e "${BOLD}Panel URL:${NC}  ${scheme}://${host}:${port}"
    if [[ -n "${admin_path}" ]]; then
        echo -e "${BOLD}Admin URL:${NC}  ${scheme}://${host}:${port}/${admin_path}"
    fi
}

cmd_health() {
    load_config
    local port="${PANEL_PORT:-8080}"
    local url="http://127.0.0.1:${port}/api/v1/monitoring/healthz"

    if curl -sf --max-time 5 "${url}" 2>/dev/null; then
        info "Health check passed: ${url}"
        return 0
    else
        error "Health check failed: ${url}"
        return 1
    fi
}

cmd_ready() {
    load_config
    local port="${PANEL_PORT:-8080}"
    local url="http://127.0.0.1:${port}/api/v1/monitoring/readyz"

    if curl -sf --max-time 5 "${url}" 2>/dev/null; then
        info "Readiness check passed: ${url}"
        return 0
    else
        error "Readiness check failed: ${url}"
        return 1
    fi
}

cmd_logs() {
    local lines="${1:-100}"
    local follow="${2:-false}"

    if [[ "${follow}" == "true" || "${follow}" == "-f" ]]; then
        journalctl -u "${SERVICE_NAME}" -f --no-pager
    else
        journalctl -u "${SERVICE_NAME}" -n "${lines}" --no-pager
    fi
}

cmd_restart() {
    require_root
    header "Restarting ${SERVICE_NAME}"
    systemctl restart "${SERVICE_NAME}"
    sleep 2
    if systemctl is-active --quiet "${SERVICE_NAME}"; then
        info "Service restarted successfully."
    else
        error "Service failed to restart. Check: journalctl -u ${SERVICE_NAME} -n 20"
        return 1
    fi
}

cmd_stop() {
    require_root
    header "Stopping ${SERVICE_NAME}"
    systemctl stop "${SERVICE_NAME}"
    info "Service stopped."
}

cmd_start() {
    require_root
    header "Starting ${SERVICE_NAME}"
    systemctl start "${SERVICE_NAME}"
    sleep 2
    if systemctl is-active --quiet "${SERVICE_NAME}"; then
        info "Service started successfully."
    else
        error "Service failed to start. Check: journalctl -u ${SERVICE_NAME} -n 20"
        return 1
    fi
}

cmd_backup() {
    require_root
    load_config
    header "Creating Backup"

    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_path="${BACKUP_DIR}/backup-${timestamp}"
    mkdir -p "${backup_path}"

    info "Backing up configuration..."
    cp -a "${CONFIG_DIR}" "${backup_path}/config"

    if [[ -n "${DATABASE_URL:-}" ]]; then
        info "Backing up database..."
        pg_dump "${DATABASE_URL}" > "${backup_path}/database.sql" 2>/dev/null || {
            warn "Database backup failed. Is PostgreSQL running?"
        }
    else
        warn "DATABASE_URL not set. Skipping database backup."
    fi

    if [[ -d "${DATA_DIR}" ]]; then
        info "Backing up data directory..."
        tar -czf "${backup_path}/data.tar.gz" -C "${DATA_DIR}" . 2>/dev/null || {
            warn "Data backup failed."
        }
    fi

    cat > "${backup_path}/manifest.json" <<EOF
{
    "timestamp": "${timestamp}",
    "version": "$(cat "${INSTALL_DIR}/VERSION" 2>/dev/null || echo 'unknown')",
    "hostname": "$(hostname)",
    "backup_path": "${backup_path}"
}
EOF

    info "Backup created: ${backup_path}"
    ls -lh "${backup_path}/"
}

cmd_restore() {
    require_root
    local backup_path="${1:-}"

    if [[ -z "${backup_path}" ]]; then
        header "Available Backups"
        local backups=()
        while IFS= read -r -d '' dir; do
            backups+=("${dir}")
        done < <(find "${BACKUP_DIR}" -maxdepth 1 -mindepth 1 -type d -print0 2>/dev/null | sort -z)

        if [[ ${#backups[@]} -eq 0 ]]; then
            fatal "No backups found in ${BACKUP_DIR}"
        fi

        local i=1
        for dir in "${backups[@]}"; do
            echo "  ${i}) $(basename "${dir}")"
            i=$((i + 1))
        done

        read -rp "Select backup number: " selection
        backup_path="${backups[$((selection - 1))]}"
    fi

    if [[ ! -d "${backup_path}" ]]; then
        fatal "Backup not found: ${backup_path}"
    fi

    header "Restoring from: ${backup_path}"

    read -rp "$(echo -e "${YELLOW}This will overwrite current data. Continue? [y/N]:${NC} ")" confirm
    [[ "${confirm}" =~ ^[Yy]$ ]] || { info "Restore cancelled."; return; }

    info "Stopping service..."
    systemctl stop "${SERVICE_NAME}" 2>/dev/null || true

    if [[ -d "${backup_path}/config" ]]; then
        info "Restoring configuration..."
        cp -a "${backup_path}/config/"* "${CONFIG_DIR}/"
    fi

    if [[ -f "${backup_path}/database.sql" ]]; then
        load_config
        if [[ -n "${DATABASE_URL:-}" ]]; then
            info "Restoring database..."
            psql "${DATABASE_URL}" < "${backup_path}/database.sql" 2>/dev/null || {
                warn "Database restore failed."
            }
        else
            warn "DATABASE_URL not set. Skipping database restore."
        fi
    fi

    if [[ -f "${backup_path}/data.tar.gz" ]]; then
        info "Restoring data directory..."
        tar -xzf "${backup_path}/data.tar.gz" -C "${DATA_DIR}" 2>/dev/null || {
            warn "Data restore failed."
        }
    fi

    info "Starting service..."
    systemctl start "${SERVICE_NAME}"
    sleep 3
    if systemctl is-active --quiet "${SERVICE_NAME}"; then
        info "Restore complete. Service is running."
    else
        error "Service failed to start after restore."
    fi
}

cmd_list_backups() {
    load_config
    header "Backups in ${BACKUP_DIR}"

    if [[ ! -d "${BACKUP_DIR}" ]]; then
        warn "Backup directory does not exist."
        return
    fi

    local count=0
    while IFS= read -r -d '' dir; do
        local name
        name=$(basename "${dir}")
        local size
        size=$(du -sh "${dir}" 2>/dev/null | cut -f1)
        local manifest="${dir}/manifest.json"
        local version="unknown"
        if [[ -f "${manifest}" ]]; then
            version=$(jq -r '.version // "unknown"' "${manifest}" 2>/dev/null || echo "unknown")
        fi
        echo -e "  ${CYAN}${name}${NC}  (${size}, version: ${version})"
        count=$((count + 1))
    done < <(find "${BACKUP_DIR}" -maxdepth 1 -mindepth 1 -type d -print0 2>/dev/null | sort -rz)

    if [[ ${count} -eq 0 ]]; then
        warn "No backups found."
    else
        echo ""
        info "Total: ${count} backup(s)"
    fi
}

cmd_update() {
    require_root
    load_config
    header "Updating ${PRODUCT_NAME}"

    local channel="${PANEL_UPDATE_CHANNEL:-stable}"
    info "Update channel: ${channel}"

    info "Creating pre-update backup..."
    cmd_backup

    info "Downloading latest version..."
    local arch
    arch=$(uname -m)
    case "${arch}" in
        x86_64)  arch="amd64" ;;
        aarch64) arch="arm64" ;;
    esac

    local url="https://github.com/cerbenum/Veyna.Panel/releases/latest/download/veyna-panel-linux-${arch}.tar.gz"
    local tmp
    tmp=$(mktemp -d)

    if ! curl -fsSL -o "${tmp}/veyna-panel.tar.gz" "${url}"; then
        fatal "Download failed. Check network connection."
    fi

    tar -xzf "${tmp}/veyna-panel.tar.gz" -C "${tmp}"

    info "Stopping service..."
    systemctl stop "${SERVICE_NAME}"

    info "Installing new version..."
    cp "${tmp}/veyna-panel" "${BINARY}"
    chmod 755 "${BINARY}"
    rm -rf "${tmp}"

    info "Running migrations..."
    sudo -u "${PANEL_USER}" "${BINARY}" --migrate-only 2>/dev/null || true

    info "Starting service..."
    systemctl start "${SERVICE_NAME}"
    sleep 3

    if systemctl is-active --quiet "${SERVICE_NAME}"; then
        local version
        version=$("${BINARY}" --version 2>/dev/null || echo "unknown")
        info "Update complete! Version: ${version}"
    else
        error "Service failed to start after update."
        warn "Rolling back..."
        cmd_rollback
    fi
}

cmd_rollback() {
    require_root
    load_config
    header "Rolling Back"

    local latest
    latest=$(find "${BACKUP_DIR}" -maxdepth 1 -mindepth 1 -type d -name "backup-*" 2>/dev/null | sort -r | head -1)

    if [[ -z "${latest}" ]]; then
        latest=$(find "${BACKUP_DIR}" -maxdepth 1 -mindepth 1 -type d -name "pre-upgrade-*" 2>/dev/null | sort -r | head -1)
    fi

    if [[ -z "${latest}" ]]; then
        fatal "No backup found to rollback to."
    fi

    info "Rolling back to: $(basename "${latest}")"
    cmd_restore "${latest}"
}

cmd_change_port() {
    require_root
    load_config
    local new_port="${1:-}"

    if [[ -z "${new_port}" ]]; then
        read -rp "$(echo -e "${CYAN}New port:${NC} ")" new_port
    fi

    if ! [[ "${new_port}" =~ ^[0-9]+$ ]] || [[ ${new_port} -lt 1 || ${new_port} -gt 65535 ]]; then
        fatal "Invalid port: ${new_port}"
    fi

    if ss -tlnp 2>/dev/null | grep -q ":${new_port} "; then
        fatal "Port ${new_port} is already in use."
    fi

    sed -i "s/^PANEL_PORT=.*/PANEL_PORT=${new_port}/" "${CONFIG_FILE}"
    info "Port changed to ${new_port}. Restarting service..."
    cmd_restart
    info "Panel is now available on port ${new_port}."
}

cmd_change_domain() {
    require_root
    load_config
    local new_domain="${1:-}"

    if [[ -z "${new_domain}" ]]; then
        read -rp "$(echo -e "${CYAN}New domain:${NC} ")" new_domain
    fi

    sed -i "s|^PANEL_BASE_URL=.*|PANEL_BASE_URL=https://${new_domain}|" "${CONFIG_FILE}"
    info "Domain changed to ${new_domain}. Restarting service..."
    cmd_restart
    info "Panel base URL updated."
}

cmd_change_base_path() {
    require_root
    load_config
    local new_path="${1:-}"

    if [[ -z "${new_path}" ]]; then
        new_path=$(openssl rand -hex 16)
        info "Generated new admin path: ${new_path}"
    fi

    sed -i "s/^PANEL_ADMIN_URL_PATH=.*/PANEL_ADMIN_URL_PATH=${new_path}/" "${CONFIG_FILE}"
    info "Admin URL path changed. Restarting service..."
    cmd_restart
    warn "New admin URL: ${PANEL_BASE_URL:-https://localhost}:${PANEL_PORT:-8080}/${new_path}"
}

cmd_reset_admin_password() {
    require_root
    load_config
    header "Reset Admin Password"

    local username="${1:-admin}"
    local new_password

    read -rsp "$(echo -e "${CYAN}New password:${NC} ")" new_password
    echo ""
    if [[ ${#new_password} -lt 12 ]]; then
        fatal "Password must be at least 12 characters."
    fi

    # Plaintext, deliberately: the panel binary hashes it with the exact
    # Argon2id build it later verifies against, on next start. A
    # shell-generated hash can't guarantee that format match (this used to
    # fall back to a PBKDF2 blob the panel could never parse).
    jq -n --arg username "${username}" --arg password "${new_password}" \
        '{username: $username, password: $password}' \
        > "${CONFIG_DIR}/password-reset.json"

    chmod 600 "${CONFIG_DIR}/password-reset.json"
    chown "${PANEL_USER}:${PANEL_GROUP}" "${CONFIG_DIR}/password-reset.json"

    info "Password reset file created. Restarting service to apply..."
    cmd_restart
    info "Password for '${username}' has been reset."
}

cmd_create_admin() {
    require_root
    load_config
    header "Create Admin User"

    local username email password

    read -rp "$(echo -e "${CYAN}Username:${NC} ")" username
    read -rp "$(echo -e "${CYAN}Email:${NC} ")" email
    read -rsp "$(echo -e "${CYAN}Password:${NC} ")" password
    echo ""

    if [[ ${#password} -lt 12 ]]; then
        fatal "Password must be at least 12 characters."
    fi

    # Plaintext, deliberately — see cmd_reset_admin_password for why.
    jq -n --arg username "${username}" --arg email "${email}" --arg password "${password}" \
        '{username: $username, email: $email, password: $password}' \
        > "${CONFIG_DIR}/create-admin-${username}.json"

    chmod 600 "${CONFIG_DIR}/create-admin-${username}.json"
    chown "${PANEL_USER}:${PANEL_GROUP}" "${CONFIG_DIR}/create-admin-${username}.json"

    info "Admin user '${username}' will be created on next service restart."
    cmd_restart
    info "Admin user '${username}' created."
}

cmd_rotate_secrets() {
    require_root
    load_config
    header "Rotating Secrets"

    local new_secret
    new_secret=$(openssl rand -hex 32)
    local new_admin_path
    new_admin_path=$(openssl rand -hex 16)

    sed -i "s/^PANEL_SECRET_KEY=.*/PANEL_SECRET_KEY=${new_secret}/" "${CONFIG_FILE}"
    sed -i "s/^PANEL_ADMIN_URL_PATH=.*/PANEL_ADMIN_URL_PATH=${new_admin_path}/" "${CONFIG_FILE}"

    info "Secrets rotated. Restarting service..."
    cmd_restart

    warn "New admin URL path: ${new_admin_path}"
    warn "Save this path! It's the only way to access the admin panel."
}

cmd_doctor() {
    load_config
    header "System Diagnostics"

    local issues=0

    # Service
    echo -e "${BOLD}Service:${NC}"
    if systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
        info "Service is running."
    else
        error "Service is not running."
        issues=$((issues + 1))
    fi

    # Binary
    echo -e "\n${BOLD}Binary:${NC}"
    if [[ -x "${BINARY}" ]]; then
        local version
        version=$("${BINARY}" --version 2>/dev/null || echo "unknown")
        info "Binary found: ${version}"
    else
        error "Binary not found or not executable: ${BINARY}"
        issues=$((issues + 1))
    fi

    # Config
    echo -e "\n${BOLD}Configuration:${NC}"
    if [[ -f "${CONFIG_FILE}" ]]; then
        info "Config file exists: ${CONFIG_FILE}"
        if [[ $(stat -c %a "${CONFIG_FILE}" 2>/dev/null) == "600" ]]; then
            info "Config permissions: 600 (correct)"
        else
            warn "Config permissions should be 600."
            issues=$((issues + 1))
        fi
    else
        error "Config file missing: ${CONFIG_FILE}"
        issues=$((issues + 1))
    fi

    # Database
    echo -e "\n${BOLD}Database:${NC}"
    if [[ -n "${DATABASE_URL:-}" ]]; then
        if psql "${DATABASE_URL}" -c "SELECT 1;" &>/dev/null; then
            info "Database connection: OK"
        else
            error "Database connection: FAILED"
            issues=$((issues + 1))
        fi
    else
        warn "DATABASE_URL not configured."
    fi

    # Certificate
    echo -e "\n${BOLD}Certificate:${NC}"
    local cert_type
    cert_type=$(detect_cert_type)
    info "Type: ${cert_type}"
    local nginx_conf="/etc/nginx/sites-available/${SERVICE_NAME}"
    if [[ -f "${nginx_conf}" ]]; then
        local cert_path
        cert_path=$(grep -oP 'ssl_certificate\s+\K[^\s;]+' "${nginx_conf}" 2>/dev/null || true)
        if [[ -n "${cert_path}" && -f "${cert_path}" ]]; then
            local expiry
            expiry=$(get_cert_expiry "${cert_path}")
            info "Expires: ${expiry}"
        else
            warn "Certificate file not found."
        fi
    fi

    # Disk space
    echo -e "\n${BOLD}Disk Space:${NC}"
    local disk_usage
    disk_usage=$(df -h "${INSTALL_DIR}" 2>/dev/null | awk 'NR==2{print $5}' | tr -d '%')
    if [[ -n "${disk_usage}" && ${disk_usage} -lt 90 ]]; then
        info "Disk usage: ${disk_usage}%"
    else
        warn "Disk usage is high: ${disk_usage:-unknown}%"
        issues=$((issues + 1))
    fi

    # Ports
    echo -e "\n${BOLD}Network:${NC}"
    local port="${PANEL_PORT:-8080}"
    if ss -tln 2>/dev/null | grep -qE "[:.]${port}[[:space:]]"; then
        info "Port ${port}: LISTENING"
    else
        error "Port ${port}: NOT LISTENING"
        issues=$((issues + 1))
    fi

    # Logs
    echo -e "\n${BOLD}Recent Errors:${NC}"
    local error_count
    error_count=$(journalctl -u "${SERVICE_NAME}" --since "1 hour ago" -p err --no-pager 2>/dev/null | wc -l || echo "0")
    if [[ ${error_count} -gt 0 ]]; then
        warn "${error_count} error(s) in the last hour."
        journalctl -u "${SERVICE_NAME}" --since "1 hour ago" -p err --no-pager -n 5 2>/dev/null || true
    else
        info "No recent errors."
    fi

    # User
    echo -e "\n${BOLD}System User:${NC}"
    if id "${PANEL_USER}" &>/dev/null; then
        info "User '${PANEL_USER}' exists."
    else
        error "User '${PANEL_USER}' not found."
        issues=$((issues + 1))
    fi

    # Summary
    echo ""
    if [[ ${issues} -eq 0 ]]; then
        info "All checks passed!"
    else
        warn "${issues} issue(s) found."
    fi
    return ${issues}
}

cmd_uninstall() {
    require_root
    header "Uninstalling ${PRODUCT_NAME}"

    read -rp "$(echo -e "${YELLOW}This will remove ${PRODUCT_NAME}. Continue? [y/N]:${NC} ")" confirm
    [[ "${confirm}" =~ ^[Yy]$ ]] || { info "Uninstall cancelled."; return; }

    systemctl stop "${SERVICE_NAME}" 2>/dev/null || true
    systemctl disable "${SERVICE_NAME}" 2>/dev/null || true
    rm -f "${SYSTEMD_UNIT}"

    # Remove nginx config
    rm -f "/etc/nginx/sites-available/${SERVICE_NAME}"
    rm -f "/etc/nginx/sites-enabled/${SERVICE_NAME}"
    # shellcheck disable=SC2015
    nginx -t 2>/dev/null && systemctl reload nginx 2>/dev/null || true

    systemctl daemon-reload

    rm -f "${BINARY}"

    read -rp "$(echo -e "${YELLOW}Remove data directory (${DATA_DIR})? [y/N]:${NC} ")" confirm_data
    if [[ "${confirm_data}" =~ ^[Yy]$ ]]; then
        rm -rf "${DATA_DIR}"
        info "Data directory removed."
    fi

    read -rp "$(echo -e "${YELLOW}Remove configuration (${CONFIG_DIR})? [y/N]:${NC} ")" confirm_config
    if [[ "${confirm_config}" =~ ^[Yy]$ ]]; then
        rm -rf "${CONFIG_DIR}"
        info "Configuration removed."
    fi

    if id "${PANEL_USER}" &>/dev/null; then
        userdel "${PANEL_USER}" 2>/dev/null || true
        info "System user '${PANEL_USER}' removed."
    fi

    info "Uninstall complete."
    if [[ -d "${BACKUP_DIR}" ]]; then
        info "Backups preserved in: ${BACKUP_DIR}"
    fi
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
    cat <<EOF
veyna-panelctl v${CTL_VERSION} — ${PRODUCT_NAME} Management CLI

Usage: veyna-panelctl <command> [args...]

Commands:
  status                  Show service status, cert type, and expiry
  url                     Print panel and admin URLs
  health                  Run health check
  ready                   Run readiness check
  logs [-f] [N]           Show logs (N lines, -f to follow)
  restart                 Restart the service
  stop                    Stop the service
  start                   Start the service
  backup                  Create a backup
  restore [PATH]          Restore from backup
  list-backups            List available backups
  update                  Update to latest version
  rollback [PATH]         Rollback to previous version
  change-port PORT        Change the panel port
  change-domain DOMAIN    Change the panel domain
  change-base-path [PATH] Change admin URL path (random if omitted)
  rotate-secrets          Rotate secret key and admin URL path
  reset-admin-password [USER] Reset admin password (default: admin)
  create-admin            Create a new admin user
  doctor                  Run system diagnostics
  uninstall               Remove ${PRODUCT_NAME}

Options:
  --version, -v           Show version
  --help, -h              Show this help

Examples:
  sudo veyna-panelctl status
  sudo veyna-panelctl url
  sudo veyna-panelctl logs -f
  sudo veyna-panelctl backup
  sudo veyna-panelctl change-port 9090
  sudo veyna-panelctl doctor
EOF
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    local cmd="${1:-}"
    shift || true

    case "${cmd}" in
        status)               cmd_status "$@" ;;
        url)                  cmd_url "$@" ;;
        health)               cmd_health "$@" ;;
        ready)                cmd_ready "$@" ;;
        logs)                 cmd_logs "$@" ;;
        restart)              cmd_restart "$@" ;;
        stop)                 cmd_stop "$@" ;;
        start)                cmd_start "$@" ;;
        backup)               cmd_backup "$@" ;;
        restore)              cmd_restore "$@" ;;
        list-backups)         cmd_list_backups "$@" ;;
        update)               cmd_update "$@" ;;
        rollback)             cmd_rollback "$@" ;;
        change-port)          cmd_change_port "$@" ;;
        change-domain)        cmd_change_domain "$@" ;;
        change-base-path)     cmd_change_base_path "$@" ;;
        rotate-secrets)       cmd_rotate_secrets "$@" ;;
        reset-admin-password) cmd_reset_admin_password "$@" ;;
        create-admin)         cmd_create_admin "$@" ;;
        doctor)               cmd_doctor "$@" ;;
        uninstall)            cmd_uninstall "$@" ;;
        --version|-v)         echo "veyna-panelctl v${CTL_VERSION}" ;;
        --help|-h|"")         usage ;;
        *)                    fatal "Unknown command: ${cmd}. Use --help for usage." ;;
    esac
}

main "$@"
